export default async function handler(req, res){
  const { mac, playlist } = req.body;
  if(!mac) return res.status(400).json({error:"MAC manquant"});
  
  const API_KEY = process.env.HOTPLAYER_API_KEY;
  
  // 1. Active le MAC
  const activateRes = await fetch(`https://hotplayer.app/api/v1/reseller/activate/${mac}`, {
    method:'POST',
    headers:{ 'X-API-KEY': API_KEY }
  });
  const activateData = await activateRes.json();
  
  // 2. Si le client a mis une playlist, on l'ajoute (sinon on s'arrête là)
  if(playlist && playlist.length > 5){
    // Gère les 2 formats : URL directe ou HOST|USER|PASS
    let finalUrl = playlist;
    if(playlist.includes('|')){
       const [host, user, pass] = playlist.split('|');
       finalUrl = `${host}:443|${user}|${pass}`; // format Xtream que HotPlayer aime
    }
    
    await fetch(`https://hotplayer.app/api/v1/reseller/add-playlists/${mac}`, {
      method:'POST',
      headers:{ 'X-API-KEY': API_KEY, 'Content-Type':'application/json' },
      body: JSON.stringify([{ name:"Playlist Auto", url: finalUrl }])
    });
  }
  
  if(activateData.status === 'success' || activateRes.ok){
    return res.json({success:true});
  } else {
    return res.json({success:false, error: "Activation échouée, MAC déjà actif ?"});
  }
} 