export default async function handler(req, res){
  if(req.method !== 'POST') return res.status(405).json({error:"Method not allowed"});
  const { mac, playlist, plan } = req.body;
  if(!mac) return res.status(400).json({error:"MAC manquant"});

  const API_KEY = process.env.HOTPLAYER_API_KEY;
  const isLifetime = plan === "2.5" || plan === "2.5 crédits";

  // 1. Activation - 1 an ou à vie selon le plan
  // Note: Sur HotPlayer, l'activation à vie consomme 2.5 crédits automatiquement côté serveur
  const activateUrl = `https://hotplayer.app/api/v1/reseller/activate/${mac}`;
  
  const activateRes = await fetch(activateUrl, {
    method:'POST',
    headers:{ 'X-API-KEY': API_KEY, 'Content-Type':'application/json' },
    body: JSON.stringify({ lifetime: isLifetime }) // si leur API gère le flag, sinon il déduira 2.5 tout seul si tu as activé à vie dans panel
  });
  
  const activateData = await activateRes.json();

  // 2. Ajoute playlist seulement si fournie
  if(playlist && activateRes.ok){
    let finalUrl = playlist;
    if(playlist.includes('|')){
       const parts = playlist.split('|');
       if(parts.length === 3) finalUrl = `${parts[0]}|${parts[1]}|${parts[2]}`;
    }
    await fetch(`https://hotplayer.app/api/v1/reseller/add-playlists/${mac}`, {
      method:'POST',
      headers:{ 'X-API-KEY': API_KEY, 'Content-Type':'application/json' },
      body: JSON.stringify([{ name:"Playlist Auto", url: finalUrl }])
    });
  }

  if(activateRes.ok || activateData.status === 'success'){
    return res.json({success:true});
  } else {
    return res.json({success:false, error: activateData.message || JSON.stringify(activateData)});
  }
}
